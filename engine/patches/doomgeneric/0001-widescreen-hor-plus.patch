+// Widescreen: shift 320-wide UI art into the centre of the real screen. A full-screen
+// 320x200 picture (title, intermission, help) also gets its side bars cleared.
+static int V_WideX(int x, int y, patch_t *patch)
+{
+    if (WIDE_DELTA == 0 || dest_screen != I_VideoBuffer)
+        return x;
+    if (x == 0 && y == 0 && SHORT(patch->width) >= ORIGWIDTH
+     && SHORT(patch->height) >= SCREENHEIGHT)
+        memset(I_VideoBuffer, 0, SCREENWIDTH * SCREENHEIGHT);
+    return x + WIDE_DELTA;
+}
+
